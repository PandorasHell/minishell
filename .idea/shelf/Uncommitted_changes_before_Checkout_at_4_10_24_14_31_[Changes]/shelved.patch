+/**
+ * @brief this function verifies the command and if it contains
+ * the allowed white spaces in shell and nothing else.
+ * @return return 1 in the event of it finding a character that
+ * isn't allowed, and 0 if the exit command is allowed.
+ */
+
+int pwd_checker(t_cmd *line, const char *command, t_denv *env)
+{
+	int i = 0;
+
+	while (line->info->word[i] && command[i])
+	{
+		if (line->info->word[i] != command[i])
+			return (false);
+		i++;
+	}
+	while (line->info->word[i])
