+		if (line->info->word[i] != ' ' && line->info->word[i] != '\t' &&
+			line->info->word[i] != '\r' && line->info->word[i] != '\n' && line->info->word[i] != '\0')
+		return (false);
+		i++;
+	}
+	if (line->next != NULL)
+		return (printf("pwd: too many arguments"), ERROR);
+	return (built_in_env(env));
+}
